{
  "name": "emdash-emit",
  "version": "0.1.5",
  "description": "AI-First Local Workspace & Sync Tool for EmDash (Cloudflare Workers + D1)",
  "author": "hiroaki <45134003+aroooy@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aroooy/emdash-emit.git"
  },
  "bugs": {
    "url": "https://github.com/aroooy/emdash-emit/issues"
  },
  "homepage": "https://github.com/aroooy/emdash-emit#readme",
  "keywords": [
    "emdash",
    "mcp",
    "model-context-protocol",
    "sync",
    "cli",
    "markdown",
    "cloudflare-workers",
    "ai-agent",
    "antigravity"
  ],
  "type": "module",
  "bin": {
    "emit": "dist/bin/emit.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x ./dist/bin/emit.js 2>/dev/null || true",
    "prepack": "npm run build",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "typecheck:src": "tsc --noEmit",
    "check": "npm run format:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.1.0",
    "commander": "^13.1.0",
    "gray-matter": "^4.0.3",
    "node-diff3": "^3.2.1",
    "ulidx": "^2.4.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.0.0",
    "prettier": "3.9.4",
    "typescript": "^7.0.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
